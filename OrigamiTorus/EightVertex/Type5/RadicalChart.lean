module

public import OrigamiTorus.EightVertex.Type5.MarkedReduction
public import OrigamiTorus.EightVertex.Type5.Periodic
import Mathlib.Tactic

/-! The five radical choices give matching distances on every Type 5 edge. -/

@[expose] public section

noncomputable section

namespace OrigamiTorus.Type5

namespace Continuation

/-- The square witness uses the same integral shifts. Convert them to the
physical coordinates of the lattice generated by `(1,0)` and `(x,y)`. -/
def shift {R : Type*} [Ring R] (x y : R) (a b : Vertex) : Plane R :=
  translatePoint x y (squareShift a b) (0,0)

theorem shift_swap (x y : ℝ) (a b : Vertex) : shift x y b a = -shift x y a b := by
  have hh : ∀ a b : Vertex, squareShift b a = -squareShift a b := by decide +kernel
  simp [shift,hh a b,translatePoint,Int.cast_neg,neg_mul]
  ring

theorem shift_anchor (x y : ℝ) (a : Vertex) : shift x y 1 a = 0 := by
  simp [shift,squareShift_cocycle.1,translatePoint]

end Continuation

/-- Four prescribed core vertices in the marking with periods (1,0) and (x,y).
The fifth core vertex is the origin. -/
structure RadicalChart where
  x : ℝ
  y : ℝ
  core : Vertex → Plane ℝ
  origin : core 1 = 0
  rootSign : Vertex → Bool
  leafSign : Vertex → Bool

namespace RadicalChart

open Continuation (shift shift_swap shift_anchor)

def offset (c : RadicalChart) (a b : Vertex) : Plane ℝ :=
  c.core a-shift c.x c.y a b

def rootPoint (c : RadicalChart) (j : Vertex) : Point3 :=
  makeRoot (c.core 2) (c.core 5) (c.offset 2 j) (c.offset 5 j) (c.core j) (c.rootSign j)

def leaf (c : RadicalChart) (j : Vertex) : LeafData ℝ :=
  normalizedLeafData (c.core 2) (c.core 5) (c.rootPoint 3) (c.rootPoint 4)
    (c.offset 2 j) (c.offset 5 j) (c.offset 3 j) (c.offset 4 j)

def leafParameter (c : RadicalChart) (j : Vertex) : ℝ :=
  let q := (c.leaf j).quadratic
  quadraticRoot q.1 q.2.1 q.2.2 (c.leafSign j)

def intrinsic (c : RadicalChart) (j : Vertex) : Plane ℝ :=
  if j ∈ leaves then (c.leaf j).intrinsicAt (c.leafParameter j) else c.core j

def extrinsic (c : RadicalChart) (j : Vertex) : Point3 :=
  if j ∈ leaves then (c.leaf j).extrinsicAt (c.leafParameter j)
  else if j ∈ roots then c.rootPoint j else atHeight (c.core j) 0

/-- Conditions for the chosen roots and leaf quadratics to reconstruct all edges. -/
structure Good (c : RadicalChart) : Prop where
  anchors : cross (c.core 2) (c.core 5) ≠ 0
  roots_pos : ∀ j ∈ roots, 0 < rootRadicand (c.core 2) (c.core 5) (c.offset 2 j) (c.offset 5 j) (c.core j)
  leaves_good : ∀ j ∈ leaves, squared2 (c.leaf j).lineNormal ≠ 0 ∧ (c.leaf j).quadratic.1 ≠ 0 ∧
    0 ≤ discriminant (c.leaf j).quadratic.1 (c.leaf j).quadratic.2.1 (c.leaf j).quadratic.2.2

theorem root_distances {c : RadicalChart} (h : c.Good) {j : Vertex} (hj : j ∈ roots) :
    let r := c.rootPoint j
    squared3 r = squared2 (c.core j) ∧
    squared3 (r-atHeight (c.core 2) 0) = squared2 (c.core j-c.offset 2 j) ∧
    squared3 (r-atHeight (c.core 5) 0) = squared2 (c.core j-c.offset 5 j) :=
  makeRoot_edges (c.core 2) (c.core 5) (c.offset 2 j) (c.offset 5 j) (c.core j) (c.rootSign j)
    h.anchors (h.roots_pos j hj).le

theorem leaf_distances {c : RadicalChart} (h : c.Good) {j : Vertex} (hj : j ∈ leaves) :
    let p := c.leaf j
    let u := p.intrinsicAt (c.leafParameter j)
    let v := p.extrinsicAt (c.leafParameter j)
    squared3 v = squared2 u ∧
    squared3 (v-atHeight (c.core 2) 0) = squared2 (u-c.offset 2 j) ∧
    squared3 (v-atHeight (c.core 5) 0) = squared2 (u-c.offset 5 j) ∧
    squared3 (v-c.rootPoint 3) = squared2 (u-c.offset 3 j) ∧
    squared3 (v-c.rootPoint 4) = squared2 (u-c.offset 4 j) := by
  obtain ⟨hn,ha,hd⟩ := h.leaves_good j hj
  let p := c.leaf j
  have hz : p.z₃ ≠ 0 := by
    have hp := (Real.sqrt_pos.mpr (h.roots_pos 3 (by decide))).ne'
    change signedRoot (c.rootSign 3) _ ≠ 0
    cases c.rootSign 3 <;> simp [signedRoot,hp]
  obtain ⟨h0,hxy,h3,h4⟩ := p.branch_sound (c.leafSign j) hz hn ha hd
  exact ⟨h0,normalizedLeafData_distances h.anchors h0 ⟨hxy,h3,h4⟩⟩

def EdgeMatch (c : RadicalChart) (a b : Vertex) : Prop :=
  squared3 (c.extrinsic b-c.extrinsic a) = squared2 (c.intrinsic b-c.intrinsic a+shift c.x c.y a b)

private theorem edgeMatch_swap {c : RadicalChart} {a b : Vertex} (h : c.EdgeMatch a b) : c.EdgeMatch b a := by
  unfold EdgeMatch at h ⊢
  rw [shift_swap]
  simp [squared2,squared3,dot,horizontal] at h ⊢
  linear_combination h

private theorem edgeMatch_origin {c : RadicalChart} (b : Vertex)
    (h : squared3 (c.extrinsic b) = squared2 (c.intrinsic b)) : c.EdgeMatch 1 b := by
  have hi : c.intrinsic 1 = 0 := by norm_num [intrinsic,leaves,c.origin]
  have he : c.extrinsic 1 = 0 := by norm_num [extrinsic,leaves,roots,c.origin,atHeight]
  simpa [EdgeMatch,shift_anchor,hi,he] using h

private theorem sub_offset (a b k : Plane ℝ) : a-(b-k) = a-b+k := by abel

private theorem oriented_edge_matches {c : RadicalChart} (h : c.Good) {e : Edge}
    (he : e ∈ orientedEdges) : c.EdgeMatch e.1 e.2 := by
  rcases e with ⟨a,b⟩
  simp only [orientedEdges,List.mem_append,List.mem_flatMap,List.mem_map] at he
  rcases he with he | ⟨j,hj,k,hk,he⟩
  · simp only [List.mem_cons,List.not_mem_nil,or_false] at he
    rcases he with he | he | he | he | he | he | he | he | he <;> rcases Prod.mk_inj.mp he with ⟨rfl,rfl⟩
    · norm_num [EdgeMatch,extrinsic,intrinsic,shift,translatePoint,leaves,roots,squareShift,positiveShift,c.origin,
        squared3,horizontal,atHeight,squared2,dot]
    · norm_num [EdgeMatch,extrinsic,intrinsic,shift,translatePoint,leaves,roots,squareShift,positiveShift,c.origin,
        squared3,horizontal,atHeight,squared2,dot]
    · norm_num [EdgeMatch,extrinsic,intrinsic,shift,translatePoint,leaves,roots,squareShift,positiveShift,c.origin,
        squared3,horizontal,atHeight,squared2,dot]
    · apply edgeMatch_origin
      simpa [extrinsic,intrinsic,leaves,roots] using (root_distances h (by decide : (3 : Vertex) ∈ roots)).1
    · simpa [EdgeMatch,extrinsic,intrinsic,leaves,roots,offset,sub_offset] using
        (root_distances h (by decide : (3 : Vertex) ∈ roots)).2.1
    · simpa [EdgeMatch,extrinsic,intrinsic,leaves,roots,offset,sub_offset] using
        (root_distances h (by decide : (3 : Vertex) ∈ roots)).2.2
    · apply edgeMatch_origin
      simpa [extrinsic,intrinsic,leaves,roots] using (root_distances h (by decide : (4 : Vertex) ∈ roots)).1
    · simpa [EdgeMatch,extrinsic,intrinsic,leaves,roots,offset,sub_offset] using
        (root_distances h (by decide : (4 : Vertex) ∈ roots)).2.1
    · simpa [EdgeMatch,extrinsic,intrinsic,leaves,roots,offset,sub_offset] using
        (root_distances h (by decide : (4 : Vertex) ∈ roots)).2.2
  · rcases Prod.mk_inj.mp he with ⟨rfl,rfl⟩
    obtain ⟨h1,h2,h5,h3,h4⟩ := leaf_distances h hj
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hk
    rcases hk with rfl | rfl | rfl | rfl | rfl
    · apply edgeMatch_origin
      simpa [extrinsic,intrinsic,hj] using h1
    all_goals
      simp only [EdgeMatch,extrinsic,intrinsic,ite_eq_left hj]
      first
      | simpa [leaves,roots,offset,sub_offset] using h2
      | simpa [leaves,roots,offset,sub_offset] using h5
      | simpa [leaves,roots,offset,sub_offset] using h3
      | simpa [leaves,roots,offset,sub_offset] using h4

/-- All twenty-four marked edges have the reconstructed lengths. -/
theorem all_edge_lengths {c : RadicalChart} (h : c.Good) {a b : Vertex} (he : orderedEdge a b ∈ edgeList) :
    c.EdgeMatch a b := by
  obtain ⟨⟨i,j⟩,hm,heq⟩ := oriented_edges_cover _ he
  have hcd := oriented_edge_matches h hm
  have eq_ordered (p q : Vertex) : c.EdgeMatch p q ↔
      c.EdgeMatch (orderedEdge p q).1 (orderedEdge p q).2 := by
    rcases le_total p q with hpq | hqp
    · simp [orderedEdge,min_eq_left hpq,max_eq_right hpq]
    · simp only [orderedEdge,min_eq_right hqp,max_eq_left hqp]
      exact ⟨edgeMatch_swap,edgeMatch_swap⟩
  apply (eq_ordered a b).mpr
  rw [← heq]
  exact (eq_ordered i j).mp hcd

end RadicalChart

end OrigamiTorus.Type5
