module

public import OrigamiTorus.Type5MarkedReduction
public import OrigamiTorus.Type5Periodic
public import OrigamiTorus.Type5BoxArithmetic
public meta import OrigamiTorus.RadicalIntervals
import OrigamiTorus.RadicalIntervals
import Mathlib.Tactic
import Mathlib.Tactic.Inclusion.Extension.IntervalDyadicReal.Tactic

/-! The exact Type 5 radical family on the nonrectangular modulus box. -/

@[expose] public section

noncomputable section

namespace OrigamiTorus.Type5.Continuation

open Inclusion IntervalDyadicReal BoxArithmetic

/-- The two coordinates of the exact PR box, with radius `10⁻¹¹` in each direction. -/
def ModulusBox (x y : ℝ) : Prop :=
  x ∈ Set.Icc (174241221608834/10^15) (174241221628834/10^15) ∧
  y ∈ Set.Icc (1084897889745590/10^15) (1084897889765590/10^15)

theorem modulus_bounds {x y : ℝ} (h : ModulusBox x y) :
    0 < x ∧ x < 1/2 ∧ 0 < y ∧ 1 < x^2+y^2 := by
  obtain ⟨hx,hy⟩ := h
  dyadic_interval +kernel [prec := 160]

/-- The four fixed physical core points, with vertex 1 at the origin. -/
def core {R : Type*} [Field R] : Vertex → Plane R :=
  ![(0,0),(0,0),(305146237868087/10^15,-605447047939750/10^15),
     (499997454165673/10^15,181480875778771/10^15),
     (-100309264271995/10^15,459493147984820/10^15),
     (-154596026157111/10^15,-274376548947718/10^15),(0,0),(0,0)]

/-- The square witness uses the same integral shifts. Convert them to the
physical coordinates of the lattice generated by `(1,0)` and `(x,y)`. -/
def shift {R : Type*} [Ring R] (x y : R) (a b : Vertex) : Plane R :=
  translatePoint x y (squareShift a b) (0,0)

def offset {R : Type*} [Field R] (x y : R) (a b : Vertex) : Plane R :=
  core a-shift x y a b

def rootPoint (x y : ℝ) (j : Vertex) : Point3 :=
  makeRoot (core 2) (core 5) (offset x y 2 j) (offset x y 5 j) (core j) (j == 3)

def leaf (x y : ℝ) (j : Vertex) : LeafData ℝ :=
  normalizedLeafData (core 2) (core 5) (rootPoint x y 3) (rootPoint x y 4)
    (offset x y 2 j) (offset x y 5 j) (offset x y 3 j) (offset x y 4 j)

def leafParameter (x y : ℝ) (j : Vertex) : ℝ :=
  let q := (leaf x y j).quadratic
  quadraticRoot q.1 q.2.1 q.2.2 (j != 6)

def intrinsic (x y : ℝ) (j : Vertex) : Plane ℝ :=
  if j ∈ leaves then (leaf x y j).intrinsicAt (leafParameter x y j) else core j

def extrinsic (x y : ℝ) (j : Vertex) : Point3 :=
  if j ∈ leaves then (leaf x y j).extrinsicAt (leafParameter x y j)
  else if j ∈ roots then rootPoint x y j else atHeight (core j) 0

theorem anchors_nondegenerate : cross (core 2) (core 5) ≠ (0 : ℝ) := by
  norm_num [cross,core]

macro "continuation_bounds" p:ident : tactic => `(tactic|
  (norm_num [extrinsic,intrinsic,leafParameter,quadraticRoot,signedRoot,makeRoot,leaf,
    normalizedLeafData,leafRootCoefficient,leafRootConstant,rootPoint,rootRadicand,projection,
    linearSolve,anchorRhs,LeafData.intrinsicAt,LeafData.extrinsicAt,LeafData.quadratic,
    LeafData.intrinsicBase,LeafData.intrinsicDirection,LeafData.extrinsicBase,LeafData.extrinsicDirection,
    LeafData.lineNormal,LeafData.lineOffset,LeafData.planarLin,discriminant,squared2,squared3,
    dot,dot3,horizontal,atHeight,smul2,smul3,cross,core,offset,shift,translatePoint,
    squareShift,positiveShift,leaves,roots]
    <;> dyadic_interval +kernel [$p := 200]))

set_option maxHeartbeats 0 in
theorem root_positive {x y : ℝ} (h : ModulusBox x y) (j : Vertex) (hj : j ∈ roots) :
    0 < rootRadicand (core 2) (core 5) (offset x y 2 j) (offset x y 5 j) (core j) := by
  obtain ⟨hx,hy⟩ := h
  fin_cases j <;> simp [roots] at hj
  all_goals continuation_bounds prec

theorem root_pivot_ne {x y : ℝ} (h : ModulusBox x y) : (rootPoint x y 3).2.2 ≠ 0 := by
  have hp := root_positive h 3 (by decide)
  exact (Real.sqrt_pos.mpr hp).ne'

def enclosure (a b : ℚ) : Interval Dyadic := Interval.Icc (rat a precision).lb (rat b precision).ub

private theorem enclosure_mem {a b : ℚ} {v : ℝ} (ha : (a : ℝ) ≤ v) (hb : v ≤ (b : ℝ)) :
    v ∈ enclosure a b := by
  rw [mem_iff_mem_map]
  exact Interval.mem_Icc_of_le (ratCast_mem _ _) ha hb (ratCast_mem _ _)

def xInterval : Interval Dyadic := enclosure (174241221608834/10^15) (174241221628834/10^15)
def yInterval : Interval Dyadic := enclosure (1084897889745590/10^15) (1084897889765590/10^15)

def xBound {x y : ℝ} (h : ModulusBox x y) : Bound x := ⟨xInterval,by
  apply enclosure_mem <;> push_cast
  exact h.1.1
  exact h.1.2⟩

def yBound {x y : ℝ} (h : ModulusBox x y) : Bound y := ⟨yInterval,by
  apply enclosure_mem <;> push_cast
  exact h.2.1
  exact h.2.2⟩

private theorem core_cast (j : Vertex) :
    (((core j : Plane ℚ).1 : ℝ), ((core j : Plane ℚ).2 : ℝ)) = core j := by
  fin_cases j <;> norm_num [core]

noncomputable def coreBounds (j : Vertex) : PlaneBounds (core j) :=
  (⟨(rational (core j : Plane ℚ).1).range,by
    rw [← congrArg Prod.fst (core_cast j)]
    exact (rational (core j : Plane ℚ).1).mem⟩,
   ⟨(rational (core j : Plane ℚ).2).range,by
    rw [← congrArg Prod.snd (core_cast j)]
    exact (rational (core j : Plane ℚ).2).mem⟩)

def shiftBounds {x y : ℝ} (X : Bound x) (Y : Bound y) (d : Period) :
    PlaneBounds (translatePoint x y d (0,0)) :=
  (plus (plus zero (integer d.1)) (times (integer d.2) X),plus zero (times (integer d.2) Y))

def offsetBounds {x y : ℝ} (X : Bound x) (Y : Bound y) (a b : Vertex) : PlaneBounds (offset x y a b) :=
  planeMinus (coreBounds a) (shiftBounds X Y (squareShift a b))

def rootBounds {x y : ℝ} (X : Bound x) (Y : Bound y) (j : Vertex) : SpaceBounds (rootPoint x y j) :=
  BoxArithmetic.root (coreBounds 2) (coreBounds 5) (offsetBounds X Y 2 j) (offsetBounds X Y 5 j)
    (coreBounds j) (j == 3)

def leafBounds {x y : ℝ} (X : Bound x) (Y : Bound y) (j : Vertex) : LeafBounds (leaf x y j) :=
  BoxArithmetic.leaf (coreBounds 2) (coreBounds 5) (rootBounds X Y 3) (rootBounds X Y 4)
    (offsetBounds X Y 2 j) (offsetBounds X Y 5 j) (offsetBounds X Y 3 j) (offsetBounds X Y 4 j)

theorem box_ne : ModulusBox (174241221618834/10^15) (1084897889755590/10^15) := by
  norm_num [ModulusBox,Set.mem_Icc]

open Lean.Parser.Tactic in
macro "compute_box_ranges" loc:(location)? : tactic => `(tactic|
  dsimp only [leafBounds,BoxArithmetic.leaf,rootBounds,BoxArithmetic.root,offsetBounds,shiftBounds,
    LeafBounds.normal,LeafBounds.discriminant,LeafBounds.quadratic,LeafBounds.vBase,
    LeafBounds.vDirection,LeafBounds.uBase,LeafBounds.uDirection,LeafBounds.linear,LeafBounds.intercept,
    LeafBounds.intrinsicAt,LeafBounds.extrinsicAt,LeafBounds.parameter,
    BoxArithmetic.coefficient,BoxArithmetic.constant,project,solve,rhs,planeMinus,planePlus,
    planeScale,spacePlus,spaceScale,height,plane,signedSqrt,sqrt,squaredSpace,squaredPlane,
    dotBounds,dotSpace,crossBounds,plus,minus,neg,times,divide,BoxArithmetic.sq,xBound,yBound] $[$loc]?)

set_option maxRecDepth 4096 in
set_option maxHeartbeats 0 in
private theorem leaf_checked : leaves.all (fun j =>
    let D := leafBounds (xBound box_ne) (yBound box_ne) j
    positive (squaredPlane D.normal).range && positive D.quadratic.1.range && positive D.discriminant.range) = true := by
  decide +kernel

set_option maxHeartbeats 1500000 in
theorem leaf_good {x y : ℝ} (h : ModulusBox x y) (j : Vertex) (hj : j ∈ leaves) :
    0 < squared2 (leaf x y j).lineNormal ∧ 0 < (leaf x y j).quadratic.1 ∧
      0 < discriminant (leaf x y j).quadratic.1 (leaf x y j).quadratic.2.1 (leaf x y j).quadratic.2.2 := by
  let D := leafBounds (xBound h) (yBound h) j
  have hcheck := List.all_eq_true.mp leaf_checked j hj
  have hc : (positive (squaredPlane D.normal).range && positive D.quadratic.1.range &&
      positive D.discriminant.range) = true := by
    dsimp only [D]
    compute_box_ranges at hcheck ⊢
    exact hcheck
  simp only [Bool.and_eq_true] at hc
  exact ⟨positive_of_check (squaredPlane D.normal) hc.1.1,positive_of_check D.quadratic.1 hc.1.2,
    positive_of_check D.discriminant hc.2⟩

theorem root_distances {x y : ℝ} (h : ModulusBox x y) {j : Vertex} (hj : j ∈ roots) :
    let r := rootPoint x y j
    squared3 r = squared2 (core j) ∧
    squared3 (r-atHeight (core 2) 0) = squared2 (core j-offset x y 2 j) ∧
    squared3 (r-atHeight (core 5) 0) = squared2 (core j-offset x y 5 j) :=
  makeRoot_edges (core 2) (core 5) (offset x y 2 j) (offset x y 5 j) (core j) (j == 3)
    anchors_nondegenerate (root_positive h j hj).le

theorem leaf_distances {x y : ℝ} (h : ModulusBox x y) {j : Vertex} (hj : j ∈ leaves) :
    let p := leaf x y j
    let u := p.intrinsicAt (leafParameter x y j)
    let v := p.extrinsicAt (leafParameter x y j)
    squared3 v = squared2 u ∧
    squared3 (v-atHeight (core 2) 0) = squared2 (u-offset x y 2 j) ∧
    squared3 (v-atHeight (core 5) 0) = squared2 (u-offset x y 5 j) ∧
    squared3 (v-rootPoint x y 3) = squared2 (u-offset x y 3 j) ∧
    squared3 (v-rootPoint x y 4) = squared2 (u-offset x y 4 j) := by
  obtain ⟨hn,ha,hd⟩ := leaf_good h j hj
  let p := leaf x y j
  have hz : p.z₃ ≠ 0 := root_pivot_ne h
  obtain ⟨h0,hxy,h3,h4⟩ := p.branch_sound (j != 6) hz hn.ne' ha.ne' hd.le
  exact ⟨h0,normalizedLeafData_distances anchors_nondegenerate h0 ⟨hxy,h3,h4⟩⟩

theorem shift_swap (x y : ℝ) (a b : Vertex) : shift x y b a = -shift x y a b := by
  have hh : ∀ a b : Vertex, squareShift b a = -squareShift a b := by decide +kernel
  simp [shift,hh a b,translatePoint,Int.cast_neg,neg_mul]
  ring

theorem shift_anchor (x y : ℝ) (a : Vertex) : shift x y 1 a = 0 := by
  simp [shift,squareShift_cocycle.1,translatePoint]

def EdgeMatch (x y : ℝ) (a b : Vertex) : Prop :=
  squared3 (extrinsic x y b-extrinsic x y a) = squared2 (intrinsic x y b-intrinsic x y a+shift x y a b)

private theorem edgeMatch_swap {x y : ℝ} {a b : Vertex} (h : EdgeMatch x y a b) : EdgeMatch x y b a := by
  unfold EdgeMatch at h ⊢
  rw [shift_swap]
  simp [squared2,squared3,dot,horizontal] at h ⊢
  linear_combination h

private theorem edgeMatch_origin {x y : ℝ} (b : Vertex)
    (h : squared3 (extrinsic x y b) = squared2 (intrinsic x y b)) : EdgeMatch x y 1 b := by
  have hi : intrinsic x y 1 = 0 := by norm_num [intrinsic,leaves,core]
  have he : extrinsic x y 1 = 0 := by norm_num [extrinsic,leaves,roots,core,atHeight]
  simpa [EdgeMatch,shift_anchor,hi,he] using h

private theorem sub_offset (a b k : Plane ℝ) : a-(b-k) = a-b+k := by abel

private theorem oriented_edge_matches {x y : ℝ} (h : ModulusBox x y) {e : Edge}
    (he : e ∈ orientedEdges) : EdgeMatch x y e.1 e.2 := by
  rcases e with ⟨a,b⟩
  simp only [orientedEdges,List.mem_append,List.mem_flatMap,List.mem_map] at he
  rcases he with he | ⟨j,hj,k,hk,he⟩
  · simp only [List.mem_cons,List.not_mem_nil,or_false] at he
    rcases he with he | he | he | he | he | he | he | he | he <;> rcases Prod.mk_inj.mp he with ⟨rfl,rfl⟩
    · norm_num [EdgeMatch,extrinsic,intrinsic,shift,translatePoint,leaves,roots,squareShift,positiveShift,
        squared3,horizontal,atHeight,squared2,dot]
    · norm_num [EdgeMatch,extrinsic,intrinsic,shift,translatePoint,leaves,roots,squareShift,positiveShift,
        squared3,horizontal,atHeight,squared2,dot]
    · norm_num [EdgeMatch,extrinsic,intrinsic,shift,translatePoint,leaves,roots,squareShift,positiveShift,
        squared3,horizontal,atHeight,squared2,dot]
    · apply edgeMatch_origin
      simpa [extrinsic,intrinsic,leaves,roots] using (root_distances h (by decide : (3 : Vertex) ∈ roots)).1
    · simpa [EdgeMatch,extrinsic,intrinsic,leaves,roots,offset,sub_offset] using
        (root_distances h (by decide : (3 : Vertex) ∈ roots)).2.1
    · simpa [EdgeMatch,extrinsic,intrinsic,leaves,roots,offset,sub_offset] using
        (root_distances h (by decide : (3 : Vertex) ∈ roots)).2.2
    · apply edgeMatch_origin
      simpa [extrinsic,intrinsic,leaves,roots] using (root_distances h (by decide : (4 : Vertex) ∈ roots)).1
    · simpa [EdgeMatch,extrinsic,intrinsic,leaves,roots,offset,sub_offset] using
        (root_distances h (by decide : (4 : Vertex) ∈ roots)).2.1
    · simpa [EdgeMatch,extrinsic,intrinsic,leaves,roots,offset,sub_offset] using
        (root_distances h (by decide : (4 : Vertex) ∈ roots)).2.2
  · rcases Prod.mk_inj.mp he with ⟨rfl,rfl⟩
    obtain ⟨h1,h2,h5,h3,h4⟩ := leaf_distances h hj
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hk
    rcases hk with rfl | rfl | rfl | rfl | rfl
    · apply edgeMatch_origin
      simpa [extrinsic,intrinsic,hj] using h1
    all_goals
      simp only [EdgeMatch,extrinsic,intrinsic,ite_eq_left hj]
      first
      | simpa [leaves,roots,offset,sub_offset] using h2
      | simpa [leaves,roots,offset,sub_offset] using h5
      | simpa [leaves,roots,offset,sub_offset] using h3
      | simpa [leaves,roots,offset,sub_offset] using h4

/-- All marked edge lengths agree identically throughout the modulus box. -/
theorem all_edge_lengths {x y : ℝ} (h : ModulusBox x y) {a b : Vertex} (he : orderedEdge a b ∈ edgeList) :
    EdgeMatch x y a b := by
  obtain ⟨⟨c,d⟩,hm,heq⟩ := oriented_edges_cover _ he
  have hcd := oriented_edge_matches h hm
  have eq_ordered (p q : Vertex) : EdgeMatch x y p q ↔
      EdgeMatch x y (orderedEdge p q).1 (orderedEdge p q).2 := by
    rcases le_total p q with hpq | hqp
    · simp [orderedEdge,min_eq_left hpq,max_eq_right hpq]
    · simp only [orderedEdge,min_eq_right hqp,max_eq_left hqp]
      exact ⟨edgeMatch_swap,edgeMatch_swap⟩
  apply (eq_ordered a b).mpr
  rw [← heq]
  exact (eq_ordered c d).mp hcd

def coordinate (x y : ℝ) (j : Vertex) : Fin 5 → ℝ :=
  ![(intrinsic x y j).1,(intrinsic x y j).2,
    (extrinsic x y j).1,(extrinsic x y j).2.1,(extrinsic x y j).2.2]

def coordinateIntervals {x y : ℝ} (h : ModulusBox x y) (j : Vertex) : Fin 5 → Interval Dyadic :=
  if j ∈ leaves then
    let D := leafBounds (xBound h) (yBound h) j
    let t := D.parameter (j != 6)
    let p := D.intrinsicAt t
    let q := D.extrinsicAt t
    ![p.1.range,p.2.range,q.1.range,q.2.1.range,q.2.2.range]
  else
    let p := coreBounds j
    if j ∈ roots then
      let q := rootBounds (xBound h) (yBound h) j
      ![p.1.range,p.2.range,q.1.range,q.2.1.range,q.2.2.range]
    else ![p.1.range,p.2.range,p.1.range,p.2.range,BoxArithmetic.zero.range]

def coordinateBox (j : Vertex) : Fin 5 → Interval Dyadic := coordinateIntervals box_ne j

set_option maxHeartbeats 1500000 in
theorem coordinate_mem {x y : ℝ} (h : ModulusBox x y) (j : Vertex) (i : Fin 5) :
    coordinate x y j i ∈ coordinateBox j i := by
  have he : coordinateIntervals h j = coordinateBox j := by
    unfold coordinateBox coordinateIntervals
    split
    · compute_box_ranges
    · split
      · compute_box_ranges
      · rfl
  rw [← he]
  unfold coordinate coordinateIntervals intrinsic extrinsic
  split
  ·
    let D := leafBounds (xBound h) (yBound h) j
    let t := D.parameter (j != 6)
    exact Fin.cases (D.intrinsicAt t).1.mem (Fin.cases (D.intrinsicAt t).2.mem
      (Fin.cases (D.extrinsicAt t).1.mem (Fin.cases (D.extrinsicAt t).2.1.mem
        (Fin.cases (D.extrinsicAt t).2.2.mem (fun k => k.elim0))))) i
  · split
    ·
      let p := coreBounds j
      let q := rootBounds (xBound h) (yBound h) j
      exact Fin.cases p.1.mem (Fin.cases p.2.mem (Fin.cases q.1.mem (Fin.cases q.2.1.mem
        (Fin.cases q.2.2.mem (fun k => k.elim0))))) i
    ·
      let p := coreBounds j
      exact Fin.cases p.1.mem (Fin.cases p.2.mem (Fin.cases p.1.mem (Fin.cases p.2.mem
        (Fin.cases BoxArithmetic.zero.mem (fun k => k.elim0))))) i

end OrigamiTorus.Type5.Continuation
